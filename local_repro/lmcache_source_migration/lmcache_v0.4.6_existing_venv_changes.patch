+    def _get_request_block_tiers(self, req_id: str) -> dict[int, str]:
+        """Match a vLLM runtime request ID to the sidecar request ID."""
+        if not hasattr(self, "_kv_importance_tiers"):
+            self._kv_importance_tiers = self._load_kv_importance_tiers()
+
+        full_req_id = str(req_id)
+        candidate_ids = [full_req_id]
+        if "-" in full_req_id:
+            candidate_ids.append(full_req_id.split("-", 1)[0])
+
+        tiers = {}
+        matched_key = None
+        for candidate_id in candidate_ids:
+            candidate_tiers = self._kv_importance_tiers.get(candidate_id)
+            if candidate_tiers is not None:
+                tiers = candidate_tiers
+                matched_key = candidate_id
+                break
+
+        logger.warning(
+            "[SC] tier lookup req_id=%s matched_key=%s blocks=%d",
+            full_req_id,
+            matched_key,
+            len(tiers),
+        )
+
+        output: dict[int, str] = {}
+        for block_index, value in tiers.items():
+            if isinstance(value, dict):
+                tier = value.get("tier", "cpu")
+            else:
+                tier = value
+            output[int(block_index)] = str(tier).lower()
+
+        return output
+
+    def _tier_to_lmcache_location(self, tier: str) -> str:
+        """Translate a GNN tier into an LMCache storage backend."""
+        if str(tier).lower() == "disk":
+            return "LocalDiskBackend"
+
+        # LMCache has no separate GPU storage backend here. Both GNN
+        # "gpu" and "cpu" map to the fast LocalCPUBackend.
+        return "LocalCPUBackend"
+
+    def _get_target_tiers_for_request(
+        self,
+        req_id: str,
+        num_tokens: int,
+        store_mask: torch.Tensor,
+        chunk_size: int,
+    ):
+        """Choose one LMCache destination for each LMCache chunk."""
+        block_tiers = self._get_request_block_tiers(req_id)
+        if not block_tiers:
+            logger.warning("[SC] No block tiers found for request %s", req_id)
+            return None
+
+        gnn_block_size = int(os.environ.get("GNN_KV_BLOCK_SIZE", "16"))
+        first_stored_token = int((~store_mask).sum().item())
+        target_locations = []
+
+        for chunk_start in range(first_stored_token, num_tokens, chunk_size):
+            chunk_end = min(chunk_start + chunk_size, num_tokens)
+            first_block = chunk_start // gnn_block_size
+            last_block = (chunk_end - 1) // gnn_block_size
+
+            chunk_block_tiers = [
+                block_tiers.get(block_index, "cpu")
+                for block_index in range(first_block, last_block + 1)
+            ]
+
+            if "gpu" in chunk_block_tiers:
+                target_tier = "gpu"
+            elif "cpu" in chunk_block_tiers:
+                target_tier = "cpu"
+            else:
+                target_tier = "disk"
+
+            target_locations.append(
+                self._tier_to_lmcache_location(target_tier)
+            )
+
+        logger.warning(
+            "[SC] req_id=%s target_tiers_count=%d sample=%s",
+            req_id,
+            len(target_locations),
+            target_locations[:8],
+        )
+        return target_locations
