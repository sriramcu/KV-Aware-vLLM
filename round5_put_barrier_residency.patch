+            {
+                **config_core,
+                "config_sha256": sha256_text(canonical_json(config_core)),
+            }
+        )
+    return grid
+
+
+def default_state_dir(max_questions: int) -> Path:
+    return (
+        Path.home()
+        / "runs"
+        / "kvaware_repro"
+        / "pressure_grid"
+        / f"{GRID_VERSION}_maxq_{max_questions}"
+    )
