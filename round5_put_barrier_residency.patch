+        "SC_LMCACHE_MEMORY_TRACE_INTERVAL_S": "5",
+        "SC_LMCACHE_LONG_PIN_THRESHOLD_S": "10",
+        "SC_LMCACHE_LONG_REF_THRESHOLD_S": "10",
+        "SC_DRIVER_RESOURCE_MONITOR_ENABLE": "1",
