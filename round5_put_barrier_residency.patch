+
+
+def make_grid(
+    max_questions: int,
+    scratch_dir: Path,
+    nodelist: str,
+) -> list[dict[str, Any]]:
+    base = base_environment(max_questions, nodelist)
+    rows: list[tuple[str, str, dict[str, str]]] = [
+        (
+            "A_nfs_no_barrier_no_dedup",
+            "A: shared NFS; no cold->warm PUT barrier; resident PUT dedup off",
+            {
+                "ROUND5_STORAGE": "shared_nfs",
+            },
+        ),
+        (
+            "B_nfs_barrier_no_dedup",
+            "B: shared NFS; drain pending PUTs before warm; resident PUT dedup off",
+            {
+                "ROUND5_STORAGE": "shared_nfs",
+                "SC_LMCACHE_COLD_WARM_PUT_BARRIER_ENABLE": "1",
+            },
+        ),
+        (
+            "C_nfs_barrier_dedup",
+            "C: shared NFS; PUT-drain barrier + completed-resident PUT dedup",
+            {
+                "ROUND5_STORAGE": "shared_nfs",
+                "SC_LMCACHE_COLD_WARM_PUT_BARRIER_ENABLE": "1",
+                "SC_LMCACHE_DISK_RESIDENT_PUT_DEDUP_ENABLE": "1",
+            },
+        ),
+        (
+            "D_scratch_no_barrier_no_dedup",
