+            {
+                "SC_LMCACHE_SCHEDULER_LOOKUP_ADMISSION_ENABLE": "1",
+                "SC_LMCACHE_SCHEDULER_LOOKUP_ADMISSION_WAIT_MS": "100",
+            },
+        ),
+        (
+            "05_scheduler_wait_1000ms",
+            "Scheduler admission enabled; max inflight 4; wait 1000 ms",
+            {
+                "SC_LMCACHE_SCHEDULER_LOOKUP_ADMISSION_ENABLE": "1",
+                "SC_LMCACHE_SCHEDULER_LOOKUP_ADMISSION_WAIT_MS": "1000",
+            },
+        ),
+        (
+            "06_worker_max_1",
+            "Worker admission enabled; max inflight 1 per TP rank",
+            {"SC_LMCACHE_WORKER_LOOKUP_ADMISSION_ENABLE": "1"},
+        ),
+        (
+            "07_worker_max_4",
+            "Worker admission enabled; max inflight 4 per TP rank",
+            {
+                "SC_LMCACHE_WORKER_LOOKUP_ADMISSION_ENABLE": "1",
+                "SC_LMCACHE_WORKER_LOOKUP_MAX_INFLIGHT": "4",
+            },
+        ),
+        (
+            "08_worker_max_12",
