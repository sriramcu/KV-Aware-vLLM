+        ),
+        (
+            "09_disk_put_default",
+            "Disk-put admission enabled; max pending 8",
+            {"SC_LMCACHE_DISK_PUT_ADMISSION_ENABLE": "1"},
+        ),
+        (
+            "10_disk_put_max_1",
+            "Disk-put admission enabled; max pending 1",
