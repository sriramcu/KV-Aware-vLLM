+        "SC_DRIVER_RESOURCE_MONITOR_INTERVAL_S": "30",
+        "CLEAN_OLD_LMCACHE": "1",
+    }
+
+
+def make_grid(max_questions: int) -> list[dict[str, Any]]:
+    base = base_environment(max_questions)
+    rows: list[tuple[str, str, dict[str, str]]] = [
