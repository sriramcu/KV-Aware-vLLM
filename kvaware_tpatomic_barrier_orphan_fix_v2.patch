+def _tp_logical_keys_from_one(key: ObjectKey) -> list[ObjectKey]:
+    """Expand one rank-local key to the full TP/PP logical object.
+
+    Current IPC key expansion uses ``local_world_size == world_size`` and
+    ``local_rank == global_rank`` for every lookup/store key.  Reconstructing
+    sibling keys here lets TP-atomic admission succeed even when one sibling
+    was already present in L1 and therefore emitted no fresh
+    ``L1_WRITE_FINISHED`` notification.
+    """
+    world_size = ObjectKey.WorldSizeFromKVRank(key.kv_rank)
+    if world_size <= 0:
+        return [key]
+    return [
+        ObjectKey(
+            chunk_hash=key.chunk_hash,
+            model_name=key.model_name,
+            kv_rank=ObjectKey.ComputeKVRank(
+                world_size=world_size,
+                global_rank=rank,
+                local_world_size=world_size,
+                local_rank=rank,
+            ),
+            object_group_id=key.object_group_id,
+            cache_salt=key.cache_salt,
+        )
+        for rank in range(world_size)
+    ]
+
