+  "lmcache_mp_congestion_slow_s": ${LMCACHE_MP_CONGESTION_SLOW_S},
+  "lmcache_mp_chthm_debug": ${LMCACHE_MP_CHTHM_DEBUG},
   "enable_vpc": ${ENABLE_VPC},
