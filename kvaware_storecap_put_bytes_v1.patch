@@ -324,5 +349,30 @@ class GNNDynamicStorePolicy(StorePolicy):
             )
         return deletions
 
+    def select_l1_deletions_on_store_skip(
+        self, keys: list[ObjectKey]
+    ) -> list[ObjectKey]:
+        if self._l2_backing:
+            from lmcache.v1.distributed.placement_metadata import get_chunk_placement
+
+            deletions = [
+                key
+                for key in keys
+                if get_chunk_placement(key.chunk_hash) == "L2"
+            ]
+        else:
+            deletions = list(keys)
+
+        if keys:
+            logger.info(
+                "[GNN_DYNAMIC_L2_SKIP] skipped_l2_keys=%d delete_l1_staging=%d "
+                "keep_l1=%d l2_backing=%s",
+                len(keys),
+                len(deletions),
+                len(keys) - len(deletions),
+                self._l2_backing,
+            )
+        return deletions
+
 
 register_store_policy("gnn_dynamic", GNNDynamicStorePolicy)
